{
  "permissions": {
    "allow": [
      "Bash(git check-ignore *)",
      "mcp__claude_ai_Claude_Docs__read",
      "mcp__claude_ai_Claude_Docs__guide",
      "mcp__claude-vscode__getDiagnostics",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_page"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_secrets.py\"",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "Checking the commit for secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_web.py\"",
            "timeout": 60,
            "statusMessage": "Rebuilding and checking starmap.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  }
}
